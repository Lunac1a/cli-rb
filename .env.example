# Copy to .env.local; explicitly set CLI_RB_ENV_FILE=.env.local before starting.
CLI_RB_BASE_URL=http://localhost:1234/v1
CLI_RB_MODEL=
CLI_RB_API_KEY=
CLI_RB_ALLOW_REMOTE=0
CLI_RB_USE_RESPONSES_API=0
# Enable only when supported by your provider/model.
# CLI_RB_REASONING_EFFORT=medium
CLI_RB_CONTEXT_WINDOW=200000
# summary (portable default), or codex_v2 for a verified Responses provider.
CLI_RB_CONTEXT_STRATEGY=summary
CLI_RB_MAX_OUTPUT_TOKENS=32768
CLI_RB_REQUEST_TIMEOUT_SECONDS=120
